{
  "expo": {
    "name": "BosqueSur Terreno",
    "slug": "bosquesur-terreno",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1b3b2a"
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "cl.bosquesur.terreno"
    },
    "extra": {
      "apiUrl": "https://bosquesur-api.onrender.com/api"
    }
  }
}
