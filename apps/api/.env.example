# ============================================================
# API - BosqueSur ES3 (copia a .env y ajusta)
# ============================================================
# Conexion a PostgreSQL que consume Prisma.
# Local con docker-compose: host=localhost, puerto=5432.
DATABASE_URL="postgresql://bosquesur:bosquesur_dev@localhost:5432/bosquesur_es3?schema=public"

# Puerto de la API
API_PORT=4000

# Seguridad JWT (usa un secreto largo y aleatorio en produccion)
JWT_SECRET="cambia_este_secreto_por_uno_largo_y_aleatorio"
JWT_EXPIRES_IN="8h"

# CORS: origenes permitidos separados por coma.
CORS_ORIGINS="http://localhost:5173"

# Entorno
NODE_ENV=development
