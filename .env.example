# ======================================================================
# Variables de entorno RAIZ (referencia general del monorepo)
# Copia este archivo a .env SOLO como guia. Cada app tiene su propio
# .env.example (apps/api/.env.example, apps/web/.env.example,
# apps/mobile/.env.example). NUNCA subas los .env reales al repositorio.
# ======================================================================

# ---- Base de datos (usada por docker-compose.yml) ----
POSTGRES_USER=bosquesur
POSTGRES_PASSWORD=bosquesur_dev
POSTGRES_DB=bosquesur_es3
POSTGRES_PORT=5432

# ---- API ----
# Cadena de conexion que consume Prisma en apps/api
DATABASE_URL=postgresql://bosquesur:bosquesur_dev@localhost:5432/bosquesur_es3?schema=public
API_PORT=4000
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=8h
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# ---- Web (Vite) ----
VITE_API_URL=http://localhost:4000/api

# ---- Movil (Expo) ----
# Usa la IP LOCAL del computador (no localhost) para un telefono fisico.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api
